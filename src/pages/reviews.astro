---
// Reviews — /reviews/. Every Google review in the `reviews` collection, word
// for word. No AggregateRating schema: self-hosted reviews aren't eligible
// for review stars on a LocalBusiness, and placeholder numbers never ship.
import SiteLayout from '../layouts/SiteLayout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import ReviewsGrid from '../components/sections/ReviewsGrid.astro';
import QuoteForm from '../components/sections/QuoteForm.astro';
import { site } from '../data/site';
import { heroImages } from '../data/photos';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Reviews', href: '/reviews/' },
];
const abs = (path: string) => new URL(path, Astro.site).toString();
---

<SiteLayout
  title={`Customer Reviews | ${site.name}, Fort Washington, MD`}
  description="Read Google reviews from families and businesses who relocated with Quest Professional Services in Fort Washington, Prince George's County, and the DC metro."
>
  <BreadcrumbSchema items={crumbs.map((c) => ({ label: c.label, url: abs(c.href) }))} />

  <ServiceHero
    kicker={site.rating.text}
    h1="Customer Reviews"
    intro={`Real Google reviews from families, businesses, and estate clients across Fort Washington, Prince George's County, and the DC metro who relocated with ${site.name}.`}
    crumbs={crumbs}
    image={heroImages['/reviews/']}
  />

  <ReviewsGrid />

  {site.googleReviewsUrl && (
    <section class="leave">
      <h2>Relocated With Us?</h2>
      <p>We'd be grateful if you shared your experience on Google.</p>
      <div class="leave-ctas">
        <a class="see" href={site.googleReviewsUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z" />
            <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
            <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z" />
          </svg>
          See Our Reviews on Google
        </a>
        <a class="leave-btn" href={site.googleReviewsUrl} target="_blank" rel="noopener">Leave a Google Review</a>
      </div>
    </section>
  )}

  <QuoteForm />
</SiteLayout>

<style>
  .leave {
    padding: var(--space-7) max(16px, 5%);
    background: var(--white);
    text-align: center;
  }
  .leave h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }
  .leave p {
    margin: var(--space-2) 0 var(--space-4);
    font-size: 1.125rem;
    color: #555;
  }
  .leave-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  .leave a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 15px 30px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--maroon-light), var(--maroon-dark));
    color: var(--white);
    font-weight: var(--font-weight-button);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .leave .see {
    border: 2px solid var(--maroon);
    background: var(--white);
    color: var(--maroon);
  }
  .leave .see:hover {
    background: var(--maroon);
    color: var(--white);
  }
  .leave .see svg {
    width: 22px;
    height: 22px;
  }
  @media (max-width: 600px) {
    .leave a {
      width: 100%;
      justify-content: center;
    }
  }
</style>
