---
// Town page template — /service-areas/<slug>/. Section order follows the
// astro-seo-architecture CITY PAGE TEMPLATE: hero + trust bar → services in
// town → why Quest here → local knowledge → process → nearby towns + map →
// reviews → FAQ (+schema) → quote CTA.
import { getCollection, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import ServiceSchema from '../../components/ServiceSchema.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ServiceCards from '../../components/service/ServiceCards.astro';
import ServiceOverview from '../../components/service/ServiceOverview.astro';
import ServiceApproach from '../../components/service/ServiceApproach.astro';
import NearbyAreas from '../../components/service/NearbyAreas.astro';
import NeighborhoodGuide from '../../components/service/NeighborhoodGuide.astro';
import HowItWorks from '../../components/sections/HowItWorks.astro';
import Reviews from '../../components/sections/Reviews.astro';
import FAQ from '../../components/sections/FAQ.astro';
import Credentials from '../../components/sections/Credentials.astro';
import QuoteForm from '../../components/sections/QuoteForm.astro';
import { site } from '../../data/site';
import { heroImages, photoStrips } from '../../data/photos';
import PhotoStrip from '../../components/sections/PhotoStrip.astro';
import { serviceBlurbs } from '../../data/serviceBlurbs';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((entry) => ({ params: { area: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'areas'>;
}

const { entry } = Astro.props;
const d = entry.data;
const area = site.serviceAreas.find((a) => a.slug === entry.id);
if (!area) throw new Error(`areas/${entry.id}.json has no matching slug in site.serviceAreas`);
// Short name for running copy ("Ready to relocate in Bowie?"); DC reads better as "DC".
const city = area.slug === 'washington-dc' ? 'DC' : area.name.replace(/, (MD|VA)$/, '');

const services = await getCollection('services');
// Town-specific versions of a service (e.g. /service-areas/alexandria-va/office-relocation/)
const areaServices = await getCollection('areaServices', (e) => e.data.area === entry.id);
const cards = d.services.map((slug) => {
  const s = services.find((e) => e.id === slug);
  if (!s) throw new Error(`Unknown service "${slug}" in areas/${entry.id}.json`);
  const pillar = site.servicePillars.find((p) => p.slug === s.data.pillar)!;
  return {
    name: pillar.services.find((x) => x.slug === slug)?.name ?? s.data.name,
    href: areaServices.some((x) => x.data.service === slug)
      ? `/service-areas/${entry.id}/${slug}/`
      : `/${s.data.pillar}/${slug}/`,
    blurb: serviceBlurbs[slug],
    icon: s.data.icon,
  };
});

const nearby = d.nearby.map((slug) => {
  const a = site.serviceAreas.find((x) => x.slug === slug);
  if (!a) throw new Error(`Unknown nearby area "${slug}" in areas/${entry.id}.json`);
  return { label: a.name, href: `/service-areas/${slug}/` };
});

const parentArea = d.parent ? site.serviceAreas.find((a) => a.slug === d.parent) : undefined;
const parent = parentArea ? { label: parentArea.name, href: `/service-areas/${parentArea.slug}/` } : undefined;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: area.name, href: `/service-areas/${entry.id}/` },
];
const abs = (path: string) => new URL(path, Astro.site).toString();
---

<SiteLayout title={d.title} description={d.description}>
  <BreadcrumbSchema items={crumbs.map((c) => ({ label: c.label, url: abs(c.href) }))} />
  <ServiceSchema
    name={`Relocation services in ${area.name}`}
    serviceType="Relocation services"
    description={d.description}
    url={abs(`/service-areas/${entry.id}/`)}
    areaServed={[area.name]}
  />

  <ServiceHero kicker={d.kicker} h1={d.h1} intro={d.intro} crumbs={crumbs} image={heroImages[`/service-areas/${entry.id}/`]} />
  <ServiceCards
    heading={`Relocation Services in ${area.name}`}
    intro={`The services ${city} customers book with us most. Each one links to full details, what’s included, and FAQs.`}
    cards={cards}
  />
  <ServiceOverview
    eyebrow={`Why ${site.name}`}
    heading={d.why.heading}
    body={d.why.body}
    included={d.neighborhoods}
    includedHeading={`Areas We Serve in ${city}`}
  />
  <ServiceApproach eyebrow="Local Knowledge" heading={d.local.heading} body={d.local.body} points={d.local.points} />
  {d.guide && <NeighborhoodGuide heading={d.guide.heading} intro={d.guide.intro} items={d.guide.items} />}
  {photoStrips[`/service-areas/${entry.id}/`] && <PhotoStrip {...photoStrips[`/service-areas/${entry.id}/`]} />}
  <HowItWorks />
  <NearbyAreas city={area.name} mapQuery={area.name} nearby={nearby} parent={parent} />
  <Reviews />
  {['washington-dc', 'alexandria-va'].includes(entry.id) && <Credentials />}
  <FAQ heading={`Relocating in ${area.name}: FAQs`} faqs={d.faqs} />
  <QuoteForm heading={`Ready to relocate in ${city}? Get Your Free Quote`} />
</SiteLayout>
