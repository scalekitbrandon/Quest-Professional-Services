---
// Quest's full-width footer: brand + credentials, one column per service
// pillar, company links, contact block, a service-area strip, and the bottom
// bar. Replaces the starter-kit Footer for this client. The ScaleKit credit
// in the bottom bar is a standing rule — never remove or reword it.
import { site } from '../data/site';
import { footerCredentials } from '../data/footer';

const year = new Date().getFullYear();
const { street, city, region, postalCode } = site.address;
const socials = site.social.filter((s) => s.href);
const [emailUser, emailDomain] = site.email.split('@');

const company = [
  { label: 'About Us', href: '/about/' },
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Service Areas', href: '/service-areas/' },
];
---

<footer class="sf">
  <div class="sf-main">
    <div class="sf-brand">
      <a class="logo" href="/" aria-label={`${site.name} home`}>
        <img src="/logo-qps.svg" alt="" width="52" height="50" />
        <span>
          <span class="logo-name">Quest Professional</span>
          <span class="logo-sub">Services</span>
        </span>
      </a>
      <p class="blurb">
        Relocation and event logistics for homes, businesses, and events across Washington, DC,
        Northern Virginia, and Maryland, with long-distance relocations to the lower 48.
      </p>
      <p class="badge">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z" /><path d="m8.5 12 2.5 2.5 4.5-5" /></svg>
        DOT &amp; MC Certified · Licensed &amp; Insured
      </p>
      <p class="license">
        <span>USDOT <strong>{site.credentials.usdot}</strong></span>
        <span>MC <strong>{site.credentials.mc}</strong></span>
        <a href={site.credentials.verifyUrl} target="_blank" rel="noopener">Verify on FMCSA</a>
      </p>
      <ul class="company">
        {company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      {socials.length > 0 && (
        <ul class="social">
          {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      )}
    </div>

    {site.servicePillars.map((p) => (
      <nav class="sf-col" aria-label={p.name}>
        <h2><a href={`/${p.slug}/`}>{p.name}</a></h2>
        <ul>
          {p.services.map((s) => <li><a href={`/${p.slug}/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </nav>
    ))}

    <div class="sf-col sf-contact">
      <h2>Contact</h2>
      <ul>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="solid"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
          <a class="phone" href={site.phoneHref}>{site.phone}</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          <a href={`mailto:${site.email}`}>{emailUser}@<wbr />{emailDomain}</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="solid"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" /></svg>
          <address>{street}<br />{city}, {region} {postalCode}</address>
        </li>
      </ul>
      <a class="cta" href="#quote">Get a Free Quote</a>
    </div>
  </div>

  <nav class="sf-areas" aria-label="Service areas">
    <h2>Serving</h2>
    <ul>
      {site.serviceAreas.map((a) => <li><a href={`/service-areas/${a.slug}/`}>{a.name}</a></li>)}
    </ul>
  </nav>

  <div class="sf-bottom">
    <p>&copy; {year} {site.name}. All rights reserved.<span class="creds"> {footerCredentials}</span></p>
    <p class="built-by">Website and Local SEO by <a href="https://scalekit.io" target="_blank" rel="noopener noreferrer">ScaleKit.io</a></p>
  </div>
</footer>

<style>
  .sf {
    --sf-text: rgb(255 255 255 / 0.72);
    background: var(--black);
    border-top: 4px solid var(--gold);
    color: var(--sf-text);
    font-size: 0.975rem;
  }
  .sf a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .sf a:hover {
    color: var(--gold-light);
  }
  .sf ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sf-main {
    display: grid;
    grid-template-columns: 1.45fr repeat(4, 1fr) 1.3fr;
    gap: var(--space-6) var(--space-5);
    padding: var(--space-7) max(16px, 5%) var(--space-6);
  }

  /* brand column */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .logo-name {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1.05;
    color: var(--white);
  }
  .logo-sub {
    display: block;
    margin-top: 2px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .blurb {
    max-width: 380px;
    margin: var(--space-4) 0;
    line-height: 1.7;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 9px 14px;
    border: 1px solid rgb(201 162 74 / 0.45);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--gold-light);
    white-space: nowrap;
  }
  .badge svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .license {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    margin: var(--space-3) 0 0;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }
  .license strong {
    color: var(--white);
    font-variant-numeric: tabular-nums;
  }
  .license a {
    color: var(--gold-light);
    text-decoration: underline;
  }
  .social {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4) !important;
  }

  /* link columns */
  .sf-col h2 {
    margin-bottom: var(--space-3);
    font-size: 1.25rem;
    color: var(--white);
  }
  .sf-col ul {
    display: grid;
    gap: 10px;
  }
  .company {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: var(--space-4) !important;
    font-weight: 600;
    color: var(--white);
  }

  /* contact column */
  .sf-contact li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .sf-contact svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 3px;
    fill: none;
    stroke: var(--gold);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sf-contact svg.solid {
    fill: var(--gold);
    stroke: none;
  }
  .sf-contact a,
  .sf-contact address {
    min-width: 0;
    font-style: normal;
    line-height: 1.5;
  }
  .phone {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--white) !important;
  }
  .phone:hover {
    color: var(--gold-light) !important;
  }
  .cta {
    display: inline-block;
    margin-top: var(--space-4);
    padding: 12px 22px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--gold-light), var(--gold));
    color: var(--black) !important;
    font-size: 0.9375rem;
    font-weight: var(--font-weight-button);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .cta:hover {
    filter: brightness(1.08);
  }

  /* service-area strip */
  .sf-areas {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 max(16px, 5%);
    padding: var(--space-4) 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .sf-areas h2 {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .sf-areas ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .sf-areas li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
  }
  /* dot on every item, so wrapped lines start the same way */
  .sf-areas li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }

  /* bottom bar */
  .sf-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: var(--space-4) max(16px, 5%) var(--space-5);
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.55);
  }
  .sf-bottom p {
    margin: 0;
  }
  .creds::before {
    content: '·';
    margin: 0 8px;
  }
  .built-by a {
    text-decoration: underline;
  }

  @media (max-width: 1200px) {
    .sf-main {
      grid-template-columns: repeat(4, 1fr);
    }
    .sf-contact {
      grid-column: 1 / -1;
    }
    .sf-brand {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: var(--space-3) var(--space-6);
    }
    .blurb {
      max-width: 560px;
      margin: 0;
    }
    .badge {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
  @media (max-width: 860px) {
    .sf-main {
      grid-template-columns: repeat(2, 1fr);
    }
    .sf-brand {
      display: block;
    }
    .blurb {
      margin: var(--space-4) 0;
    }
    .sf-areas {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
  @media (max-width: 520px) {
    .sf-main {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5) var(--space-4);
      padding-top: var(--space-6);
    }
    .sf-contact {
      grid-column: 1 / -1;
    }
    .sf-bottom {
      flex-direction: column;
    }
    .creds {
      display: block;
    }
    .creds::before {
      content: none;
    }
  }
</style>
