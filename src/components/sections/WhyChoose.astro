---
// "Why Choose" — image left; heading, story, 3 check points, quote CTA right.
// Layout follows Brandon's reference; copy is Quest's own. Claims here
// (20+ years, DOT/MC certified, licensed & insured, upfront quotes) match the hero trust cards
// and are pending client confirmation.
import { site } from '../../data/site';
import { photos, type Photo } from '../../data/photos';

interface Props {
  /** Defaults to the team photo in front of the truck. */
  image?: Photo;
}

const { image = photos.team } = Astro.props;

const points = [
  'Trusted by families, businesses, and estate clients for over 20 years.',
  'DOT and MC certified, licensed, and insured, with crews who treat your belongings like their own.',
  'Free, upfront quotes with no surprise charges on relocation day.',
];
---

<section class="why" aria-labelledby="why-heading">
  <div class="why-inner">
    <div class="media">
      {image ? (
        <img src={image.src} alt={image.alt} loading="lazy" width="900" height="826" />
      ) : (
        <span class="placeholder">
          <img src="/logo-qps.svg" alt="" width="220" height="213" />
        </span>
      )}
    </div>

    <div class="content">
      <p class="eyebrow">Why Choose Us</p>
      <h2 id="why-heading">{site.name}: Trusted Relocation &amp; Logistics Across the DC Metro</h2>
      <p class="story">
        Based just outside DC in Fort Washington, MD, {site.name} has spent more than 20 years
        helping families, businesses, event teams, and estates across Washington, DC, Alexandria,
        and Maryland. Our crews handle residential and corporate relocations, event logistics,
        freight transport, and estate cleanouts, with the same care whether it's a studio
        apartment, a conference load-in, or a full commercial load.
      </p>

      <ul class="points">
        {points.map((p) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 13 6 6L21 6" /></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>

      <a class="btn" href="#quote">Get a Quote</a>
    </div>
  </div>
</section>

<style>
  .why {
    padding: var(--space-4) max(16px, 5%) var(--space-8);
    background: var(--white);
  }
  .why-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-6);
    max-width: 1200px;
    margin: 0 auto;
  }

  .media {
    aspect-ratio: 1.09;
    overflow: hidden;
  }
  .media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 30% 20%, var(--maroon-light), var(--maroon) 50%, var(--maroon-dark));
  }
  .placeholder img {
    width: 40%;
    height: auto;
  }

  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-dark);
  }
  h2 {
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1.1;
    color: var(--black);
    text-wrap: balance;
  }
  .story {
    margin: var(--space-4) 0 var(--space-5);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #5a5a5a;
  }

  .points {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }
  .points li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--black);
  }
  .points svg {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    margin-top: 1px;
    fill: none;
    stroke: var(--gold);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .btn {
    display: inline-block;
    padding: 16px 32px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--maroon-light), var(--maroon-dark));
    color: var(--white);
    font-weight: var(--font-weight-button);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: filter 0.2s;
  }
  .btn:hover {
    filter: brightness(1.15);
  }

  @media (max-width: 900px) {
    .why-inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .media {
      aspect-ratio: 1.6;
    }
  }
  @media (max-width: 600px) {
    .why {
      padding-block: var(--space-7);
    }
    .points li {
      font-size: 1.0625rem;
    }
    .btn {
      display: block;
      text-align: center;
    }
  }
</style>
