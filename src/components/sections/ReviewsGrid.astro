---
// Full reviews list for /reviews/: every review in the collection as a grid,
// full text (no clamping). Same card look as the home carousel.
import { getReviews, timeAgo, avatarColors, initial, formatReview } from '../../lib/reviews';

const reviews = await getReviews();
---

<section class="rgrid" aria-label="Customer reviews">
  <ul class="grid">
    {reviews.map((r, i) => (
      <li class="card">
        <div class="card-top">
          {r.avatar ? (
            <img class="avatar" src={r.avatar} alt="" width="48" height="48" loading="lazy" />
          ) : (
            <span class="avatar initial" style={`background:${avatarColors[i % avatarColors.length]}`} aria-hidden="true">{initial(r.name)}</span>
          )}
          <div class="who">
            <p class="name">{r.name}</p>
            <p class="when">{timeAgo(r.date)}{r.location && <> · {r.location}</>}</p>
          </div>
          <svg class="g" viewBox="0 0 48 48" role="img" aria-label="Google review">
            <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z" />
            <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
            <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z" />
          </svg>
        </div>
        <div class="stars" role="img" aria-label={`${r.rating} out of 5 stars`}>
          {Array.from({ length: 5 }).map((_, s) => (
            <svg viewBox="0 0 24 24" class={s < r.rating ? 'on' : 'off'} aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" /></svg>
          ))}
        </div>
        <p class="text" set:html={formatReview(r.text)} />
      </li>
    ))}
  </ul>
</section>

<style>
  .rgrid {
    padding: var(--space-7) max(16px, 5%) var(--space-8);
    background: var(--cream);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    align-items: start;
    gap: var(--space-4);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .card {
    padding: 22px;
    background: var(--white);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 18px rgb(0 0 0 / 0.08);
  }
  .card-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }
  .initial {
    display: grid;
    place-items: center;
    color: var(--white);
    font-size: 1.375rem;
    font-weight: 600;
  }
  .who {
    flex: 1;
    min-width: 0;
  }
  .name {
    margin: 0;
    font-weight: 700;
  }
  .when {
    margin: 2px 0 0;
    font-size: 0.875rem;
    color: #6b6b6b;
  }
  .g {
    flex-shrink: 0;
    align-self: flex-start;
    width: 24px;
    height: 24px;
  }
  .stars {
    display: flex;
    gap: 2px;
    margin: 14px 0 12px;
  }
  .stars svg {
    width: 20px;
    height: 20px;
  }
  .stars .on {
    fill: var(--gold);
  }
  .stars .off {
    fill: #ddd;
  }
  .text {
    margin: 0;
    white-space: pre-line;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
</style>
