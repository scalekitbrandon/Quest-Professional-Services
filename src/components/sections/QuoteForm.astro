---
// Quote form band — maroon section: pitch + phone on the left, the GHL
// quote form (GhlForm) in a white card on the right. Leads go straight into
// the client's GoHighLevel sub-account.
import { site } from '../../data/site';
import GhlForm from '../GhlForm.astro';

interface Props {
  heading?: string;
}

const { heading = 'Get Your Free, Upfront Relocation Quote' } = Astro.props;
---

<section class="quote" id="quote" aria-labelledby="quote-heading">
  <div class="quote-inner">
    <div class="pitch">
      <p class="eyebrow">Free Quote</p>
      <h2 id="quote-heading">{heading}</h2>
      <p class="sub">
        Tell us about your relocation and we'll send a clear price with no surprise charges. Relocating
        soon? Call us and we'll walk you through it.
      </p>

      <a class="phone" href={site.phoneHref}>
        <span class="phone-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
        </span>
        <span>
          <small>Call us</small>
          {site.phone}
        </span>
      </a>

      <ul class="checks">
        <li>Local, long-distance &amp; commercial relocations</li>
        <li>Event logistics &amp; freight transport</li>
        <li>Estate cleanouts &amp; liquidation</li>
        <li>No-obligation, upfront pricing</li>
        <li>U.S. DOT #{site.credentials.usdot} · MC #{site.credentials.mc}</li>
      </ul>
    </div>

    <div class="card">
      <GhlForm />
    </div>
  </div>
</section>

<style>
  .quote {
    padding: var(--space-8) max(16px, 5%);
    background:
      radial-gradient(ellipse at 15% 20%, rgb(255 255 255 / 0.08), transparent 55%),
      linear-gradient(135deg, var(--maroon) 0%, var(--maroon-dark) 100%);
    color: var(--white);
  }
  .quote-inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: var(--space-7);
    max-width: 1200px;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-light);
  }
  h2 {
    font-size: clamp(2.125rem, 3.6vw, 3.125rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .sub {
    margin: var(--space-3) 0 var(--space-5);
    font-size: 1.125rem;
    line-height: 1.65;
    color: rgb(255 255 255 / 0.88);
  }

  .phone {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--white);
    font-size: 1.75rem;
    font-weight: 700;
    text-decoration: none;
  }
  .phone small {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-light);
  }
  .phone-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--maroon-dark);
  }
  .phone-icon svg {
    width: 26px;
    height: 26px;
    fill: currentColor;
  }

  .checks {
    display: grid;
    gap: 10px;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .checks li {
    position: relative;
    padding-left: 30px;
    font-size: 1.0625rem;
  }
  .checks li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 4px;
    width: 14px;
    height: 7px;
    border-left: 3px solid var(--gold);
    border-bottom: 3px solid var(--gold);
    transform: rotate(-45deg);
  }

  .card {
    padding: var(--space-3);
    background: var(--white);
    border-top: 5px solid var(--gold);
    border-radius: var(--radius-md);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.3);
    color: var(--black);
  }
  @media (max-width: 960px) {
    .quote-inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
  @media (max-width: 600px) {
    .quote {
      padding-block: var(--space-7);
    }
    .card {
      padding: var(--space-2);
    }
    .phone {
      font-size: 1.5rem;
    }
  }
</style>
