---
// Credentials band: federal DOT + MC certification and licensed & insured.
// USDOT / MC numbers render only once they're filled in site.credentials.
import { site } from '../../data/site';

const { usdot, mc } = site.credentials;
const items = [
  { title: 'U.S. DOT Certified', text: 'Registered with the U.S. Department of Transportation to operate commercial trucks.', id: usdot && `USDOT #${usdot}` },
  { title: 'Motor Carrier (MC) Certified', text: 'Federal operating authority for transportation across state lines.', id: mc && `MC #${mc}` },
  { title: 'Licensed & Insured', text: 'Every relocation, delivery, and cleanout is handled by a licensed, insured crew.', id: '' },
];
---

<section class="creds" aria-labelledby="creds-heading">
  <div class="creds-inner">
    <header class="head">
      <p class="eyebrow">Credentials</p>
      <h2 id="creds-heading">Certified for Local &amp; Interstate Relocations</h2>
    </header>
    <ul class="grid">
      {items.map((it) => (
        <li>
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4 8 10v12c0 10 7 18 16 22 9-4 16-12 16-22V10z" /><path d="m17 24 5 5 10-11" /></svg>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
          {it.id && <p class="id">{it.id}</p>}
        </li>
      ))}
    </ul>
    {site.credentials.verifyUrl && (
      <p class="verify">
        Look up our federal record on the
        <a href={site.credentials.verifyUrl} target="_blank" rel="noopener">FMCSA SAFER system</a>.
      </p>
    )}
  </div>
</section>

<style>
  .creds {
    padding: var(--space-7) max(16px, 5%);
    background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-dark) 100%);
    color: var(--white);
  }
  .creds-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .head {
    margin-bottom: var(--space-5);
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-light);
  }
  h2 {
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid li {
    padding: var(--space-5) var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-top: 4px solid var(--gold);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.05);
    text-align: center;
  }
  svg {
    width: 52px;
    height: 52px;
    fill: none;
    stroke: var(--gold-light);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  h3 {
    margin-top: var(--space-2);
    font-size: 1.5rem;
  }
  .grid p {
    margin: var(--space-2) 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.86);
  }
  .grid .id {
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--gold-light);
  }
  .verify {
    margin: var(--space-4) 0 0;
    text-align: center;
    color: rgb(255 255 255 / 0.86);
  }
  .verify a {
    color: var(--gold-light);
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
