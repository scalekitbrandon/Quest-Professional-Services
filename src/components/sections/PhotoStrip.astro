---
// Small row of real job photos (before/after, crew at work). Built for the
// client's small originals: images never render wider than 240px.
import type { Photo } from '../../data/photos';

interface Props {
  heading: string;
  intro: string;
  photos: Photo[];
}

const { heading, intro, photos } = Astro.props;
---

<section class="strip" aria-labelledby="strip-heading">
  <div class="strip-inner">
    <header class="head">
      <p class="eyebrow">Real Jobs</p>
      <h2 id="strip-heading">{heading}</h2>
      <p class="sub">{intro}</p>
    </header>
    <ul class="grid">
      {photos.map((p) => (
        <li><img src={p.src} alt={p.alt} width="240" height="320" loading="lazy" /></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .strip {
    padding: var(--space-7) max(16px, 5%);
    background: var(--white);
  }
  .strip-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .head {
    max-width: 760px;
    margin: 0 auto var(--space-5);
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-dark);
  }
  h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.15;
    text-wrap: balance;
  }
  .sub {
    margin: var(--space-2) 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #5a5a5a;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 220px));
    justify-content: center;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid li {
    overflow: hidden;
    border-radius: var(--radius-sm);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.12);
    aspect-ratio: 3 / 4;
  }
  .grid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
