---
// Google reviews carousel: heading + subtext, then review cards (avatar or
// initial, name, time ago, Google mark, stars, clamped text + Read more).
// Layout follows Brandon's reference. Reviews come from the `reviews`
// content collection, copied word for word from Google.
import { site } from '../../data/site';
import { getReviews, timeAgo, avatarColors, initial, formatReview } from '../../lib/reviews';

interface Props {
  /** "See Our Reviews on Google" button under the carousel (on by default). */
  googleButton?: boolean;
}

const { googleButton = true } = Astro.props;
const reviews = await getReviews();
---

<section class="reviews" aria-labelledby="reviews-heading">
  <div class="reviews-inner">
    <header class="reviews-head">
      <p class="eyebrow">Reviews</p>
      <h2 id="reviews-heading">What Our Clients Say About Us</h2>
      <p class="sub">
        Families, businesses, and event teams across Washington, DC, Alexandria, and Maryland
        trust {site.name} with their relocations. Here's what they have to say.
      </p>
    </header>

    <div class:list={['carousel', { few: reviews.length < 4 }]}>
      <button class="arrow prev" type="button" aria-label="Previous reviews">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
      </button>

      <ul class="track" tabindex="0">
        {reviews.map((r, i) => (
          <li class="card">
            <div class="card-top">
              {r.avatar ? (
                <img class="avatar" src={r.avatar} alt="" width="48" height="48" loading="lazy" />
              ) : (
                <span class="avatar initial" style={`background:${avatarColors[i % avatarColors.length]}`} aria-hidden="true">
                  {initial(r.name)}
                </span>
              )}
              <div class="who">
                <p class="name">{r.name}</p>
                <p class="when">{timeAgo(r.date)}</p>
              </div>
              <svg class="g" viewBox="0 0 48 48" role="img" aria-label="Google review">
                <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z" />
                <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
                <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
                <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z" />
              </svg>
            </div>

            <div class="stars" role="img" aria-label={`${r.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, s) => (
                <svg viewBox="0 0 24 24" class={s < r.rating ? 'on' : 'off'} aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" /></svg>
              ))}
            </div>

            <p class="text" set:html={formatReview(r.text)} />
            <div class="card-foot">
              <button class="more" type="button" hidden>Read more</button>
              {r.location && (
                <span class="loc">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" /></svg>
                  {r.location}
                </span>
              )}
            </div>
          </li>
        ))}
      </ul>

      <button class="arrow next" type="button" aria-label="Next reviews">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
      </button>
    </div>

    {googleButton && site.googleReviewsUrl && (
      <p class="all">
        <a class="google-btn" href={site.googleReviewsUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z" />
            <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
            <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z" />
          </svg>
          See Our Reviews on Google
        </a>
      </p>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.reviews').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const step = () => (track.querySelector<HTMLElement>('.card')?.offsetWidth ?? 300) + 20;
    root.querySelector('.prev')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    root.querySelector('.next')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));

    // Only show "Read more" on reviews that are actually clamped.
    root.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      const text = card.querySelector<HTMLElement>('.text')!;
      const btn = card.querySelector<HTMLButtonElement>('.more')!;
      btn.hidden = text.scrollHeight <= text.clientHeight + 1;
      btn.addEventListener('click', () => {
        const open = card.classList.toggle('expanded');
        btn.textContent = open ? 'Show less' : 'Read more';
      });
    });
  });
</script>

<style>
  .reviews {
    padding: var(--space-7) max(16px, 5%) var(--space-8);
    background: var(--white);
  }
  .reviews-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .reviews-head {
    max-width: 880px;
    margin: 0 auto var(--space-6);
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-dark);
  }
  h2 {
    font-size: clamp(2.125rem, 4vw, 3.25rem);
    line-height: 1.1;
    color: var(--black);
    text-wrap: balance;
  }
  .sub {
    margin: var(--space-3) 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: #5a5a5a;
    text-wrap: balance;
  }

  .carousel {
    position: relative;
  }
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * 20px) / 4);
    gap: 20px;
    margin: 0;
    padding: 6px 6px 24px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .few .track {
    justify-content: center;
  }
  .few .arrow {
    display: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 22px 22px 20px;
    background: var(--white);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 18px rgb(0 0 0 / 0.1);
    scroll-snap-align: start;
  }
  .card-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }
  .initial {
    display: grid;
    place-items: center;
    color: var(--white);
    font-size: 1.375rem;
    font-weight: 600;
  }
  .who {
    flex: 1;
    min-width: 0;
  }
  .name {
    margin: 0;
    font-weight: 700;
    color: var(--black);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .when {
    margin: 2px 0 0;
    font-size: 0.875rem;
    color: #6b6b6b;
  }
  .g {
    flex-shrink: 0;
    align-self: flex-start;
    width: 24px;
    height: 24px;
  }

  .stars {
    display: flex;
    gap: 2px;
    margin: 14px 0 12px;
  }
  .stars svg {
    width: 20px;
    height: 20px;
  }
  .stars .on {
    fill: var(--gold);
  }
  .stars .off {
    fill: #ddd;
  }

  .text {
    margin: 0;
    white-space: pre-line;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--black);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .expanded .text {
    -webkit-line-clamp: unset;
    display: block;
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 12px;
  }
  .loc {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--gold-dark);
  }
  .loc svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  .more {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.9375rem;
    color: #6b6b6b;
    cursor: pointer;
  }
  .more:hover {
    color: var(--maroon);
    text-decoration: underline;
  }

  .arrow {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
    color: var(--black);
    cursor: pointer;
    transform: translateY(-50%);
    transition: background 0.2s, color 0.2s;
  }
  .arrow:hover {
    background: var(--maroon);
    color: var(--white);
  }
  .arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .prev {
    left: -20px;
  }
  .next {
    right: -20px;
  }

  .all {
    margin: var(--space-4) 0 0;
    text-align: center;
  }
  .google-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 28px;
    border: 2px solid var(--maroon);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--maroon);
    font-weight: var(--font-weight-button);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .google-btn svg {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
  }
  .google-btn:hover {
    background: var(--maroon);
    color: var(--white);
  }
  @media (max-width: 600px) {
    .google-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 1100px) {
    .track {
      grid-auto-columns: calc((100% - 20px) / 2);
    }
  }
  @media (max-width: 600px) {
    .reviews {
      padding-block: var(--space-6) var(--space-7);
    }
    .track {
      grid-auto-columns: 86%;
    }
    /* swipe on phones; arrows would cover the card text */
    .arrow {
      display: none;
    }
  }
</style>
