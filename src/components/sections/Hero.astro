---
// Home hero: full-bleed photo + overlay, rating line, keyword-led H1,
// dual CTA (call / quote), then a row of 4 feature cards under the image.
// Layout follows Brandon's reference; colors/copy are Quest's own.
import { site } from '../../data/site';
import type { Photo } from '../../data/photos';

interface Props {
  /** Background photo. Falls back to a brand gradient. */
  image?: Photo;
}

const { image } = Astro.props;
const { rating } = site;
---

<section class:list={['hero', { 'has-img': image }]}>
  {image && <img class="hero-bg" src={image.src} alt={image.alt} width="1512" height="756" fetchpriority="high" decoding="async" />}
  <div class="hero-inner">
    <div class="rating">
      <span class="stars" aria-hidden="true">
        {Array.from({ length: 5 }).map(() => (
          <svg viewBox="0 0 24 24"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
        ))}
      </span>
      <p>{rating.text}</p>
    </div>

    <h1>
      <span class="h1-kicker">Serving DC, Northern Virginia &amp; Maryland</span>
      <span class="h1-main">Washington, DC Relocation &amp; Event Logistics Company</span>
    </h1>

    <p class="lede">
      Residential and commercial relocation, corporate relocations, event logistics, freight
      delivery, and specialized transportation throughout Washington, DC, Northern Virginia, and
      Maryland. From local relocations to complex event operations and long-distance relocations,
      we coordinate the people, equipment, and logistics to get the job done.
    </p>

    <div class="ctas">
      <a class="btn btn-gold" href="#quote">Get a Free Quote</a>
      <a class="btn btn-outline" href={site.phoneHref}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
        Call Us {site.phone}
      </a>
    </div>
  </div>
</section>

<div class="features">
  <ul class="features-grid">
    <li class="feature">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <path class="ln" d="M12 10h30v46H12z"/>
        <path class="ln" d="M20 6h14v8H20zM18 24h18M18 32h18M18 40h8"/>
        <circle class="acc acc-solid" cx="44" cy="42" r="12"/>
        <path class="ln-w" d="m38 42 4 4 8-8"/>
        <path class="pin" d="m38 52-3 9 9-4 9 4-3-9" opacity=".9"/>
      </svg>
      <span>
        DOT &amp; MC Certified, <span class="nw">Licensed &amp; Insured</span>
        <small class="lic"><span class="nw">USDOT {site.credentials.usdot}</span><span class="nw">MC {site.credentials.mc}</span></small>
      </span>
    </li>
    <li class="feature">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <path class="pin" d="m20 40-6 20 9-5 5 8 4-15zM44 40l6 20-9-5-5 8-4-15z"/>
        <circle class="acc acc-solid" cx="32" cy="26" r="20"/>
        <circle class="ln fill" cx="32" cy="26" r="14"/>
        <text x="32" y="31" text-anchor="middle" font-size="14" font-weight="800" font-family="Raleway, sans-serif" class="num">20+</text>
      </svg>
      <span>20+ Years Experience</span>
    </li>
    <li class="feature">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <rect class="acc" x="6" y="22" width="32" height="22" rx="2"/>
        <path class="ln" d="M6 22h32v22H6zM38 30h10l8 9v5H38zM46 30v9h10"/>
        <circle class="ln fill" cx="16" cy="48" r="5"/>
        <circle class="ln fill" cx="48" cy="48" r="5"/>
        <circle class="pin" cx="22" cy="10" r="7"/>
        <path class="ln-w" d="M22 6v4l3 2"/>
      </svg>
      <span>Speed, Efficiency &amp; Care</span>
    </li>
    <li class="feature">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <path class="acc" d="M14 6h28l10 10v42H14z"/>
        <path class="ln" d="M14 6h28l10 10v42H14zM42 6v10h10M22 28h22M22 36h22M22 44h12"/>
        <circle class="pin" cx="46" cy="48" r="11"/>
        <path class="ln-w" d="M46 42v12M49 44.5c-.8-1-1.8-1.5-3-1.5-1.7 0-3 .9-3 2.2 0 3 6 1.6 6 4.6 0 1.3-1.3 2.2-3 2.2-1.3 0-2.4-.6-3.2-1.6"/>
      </svg>
      <span>Free, Upfront Quotes</span>
    </li>
  </ul>
</div>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(480px, calc(100svh - 300px), 700px);
    padding: var(--space-5) max(16px, 5%);
    color: var(--white);
    text-align: center;
    background:
      linear-gradient(180deg, rgb(13 13 13 / 0.55) 0%, rgb(13 13 13 / 0.45) 45%, rgb(13 13 13 / 0.7) 100%),
      radial-gradient(ellipse at 70% 30%, var(--maroon-light) 0%, var(--maroon) 35%, var(--maroon-dark) 65%, var(--black) 100%);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }
  /* dark-to-maroon wash keeps the headline readable over the photo */
  .has-img::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(13 13 13 / 0.62) 0%, rgb(13 13 13 / 0.5) 45%, rgb(13 13 13 / 0.78) 100%),
      linear-gradient(90deg, rgb(74 17 20 / 0.55), rgb(74 17 20 / 0.25) 50%, rgb(74 17 20 / 0.55));
  }
  .hero-inner {
    max-width: 1200px;
  }

  .rating {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .stars {
    display: flex;
    gap: 4px;
  }
  .stars svg {
    width: 26px;
    height: 26px;
    fill: var(--gold);
  }
  .rating p {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 500;
  }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
  }
  .h1-kicker {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.4vw, 1.25rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-light);
  }
  .h1-main {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .lede {
    max-width: 900px;
    margin: var(--space-4) auto 0;
    text-wrap: balance;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.92);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    border-radius: var(--radius-sm);
    font-size: 1.0625rem;
    font-weight: var(--font-weight-button);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, filter 0.2s;
  }
  .btn svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .btn-gold {
    background: linear-gradient(135deg, var(--gold-light), var(--gold));
    color: var(--black);
  }
  .btn-gold:hover {
    filter: brightness(1.08);
  }
  .btn-outline {
    border: 2px solid var(--white);
    color: var(--white);
  }
  .btn-outline:hover {
    background: var(--white);
    color: var(--maroon);
  }

  /* ---------- Feature cards ---------- */
  .features {
    padding: var(--space-3) max(16px, 5%) var(--space-7);
    background: var(--white);
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    max-width: 1320px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .feature {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 20px 22px;
    background: var(--white);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 18px rgb(0 0 0 / 0.1);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--black);
  }
  .lic {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
    margin-top: 4px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--gold-dark);
  }
  .nw {
    white-space: nowrap;
  }
  .feature svg {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
  }
  .feature .ln,
  .feature .ln-w,
  .feature .pin-ln {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .feature .ln { stroke: var(--maroon-dark); }
  .feature .ln.fill { fill: var(--white); }
  .feature .ln-w { stroke: var(--white); }
  .feature .pin-ln { stroke: var(--gold); stroke-width: 4; }
  .feature .acc { fill: var(--gold); opacity: 0.55; }
  .feature .acc-solid { opacity: 1; }
  .feature .pin { fill: var(--maroon); }
  .feature .pin-dot { fill: var(--white); }
  .feature .num { fill: var(--maroon); }

  @media (max-width: 1100px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .hero {
      min-height: 504px;
      padding-block: var(--space-7);
    }
    .stars svg {
      width: 24px;
      height: 24px;
    }
    .rating p {
      font-size: 1rem;
    }
    .ctas .btn {
      width: 100%;
      justify-content: center;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
    .feature {
      font-size: 1.1875rem;
      padding: 20px;
    }
  }
</style>
