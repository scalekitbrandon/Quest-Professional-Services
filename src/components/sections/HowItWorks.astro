---
// "How It Works" — 4-step process on a connected timeline, then dual CTA.
// No reference supplied; designed in the site's existing card/icon language.
import { site } from '../../data/site';

interface Props {
  /** 'freight' swaps in pickup/delivery wording for the Logistics pages. */
  variant?: 'relocation' | 'freight';
}

const { variant = 'relocation' } = Astro.props;

const movingSteps = [
  {
    title: 'Request Your Free Quote',
    text: 'Call or fill out our quick form. Tell us what you’re relocating, where it’s going, and when.',
    icon: 'phone',
  },
  {
    title: 'Get a Clear Relocation Plan',
    text: 'We confirm your date, crew, and packing needs, and give you an upfront price with no surprises.',
    icon: 'plan',
  },
  {
    title: 'Relocation Day',
    text: 'Our crew arrives on time, protects your floors and furniture, then wraps, loads, and transports everything.',
    icon: 'truck',
  },
  {
    title: 'Settle In',
    text: 'We unload, place furniture where you want it, and unpack if you’d like.',
    icon: 'home',
  },
];

const freightSteps = [
  {
    title: 'Request Your Free Quote',
    text: 'Call or fill out our quick form. Tell us what’s being shipped, the pickup and delivery addresses, and your timing.',
    icon: 'phone',
  },
  {
    title: 'Confirm the Pickup Plan',
    text: 'We confirm the pickup date, the truck and crew, and give you an upfront price with no surprises.',
    icon: 'plan',
  },
  {
    title: 'Pickup & Transport',
    text: 'Our crew arrives on time, loads and secures everything so nothing shifts, and heads straight to the destination.',
    icon: 'truck',
  },
  {
    title: 'Delivered & Unloaded',
    text: 'We unload and place items where you need them, not just at the curb, and confirm the delivery with you.',
    icon: 'dropoff',
  },
];

const steps = variant === 'freight' ? freightSteps : movingSteps;
const copy = variant === 'freight'
  ? { heading: 'A Simple, Reliable Freight & Delivery Process', sub: 'Four steps from first call to final drop-off, whether it’s across Prince George’s County or across the lower 48.' }
  : { heading: 'A Simple, <span class="nw">Stress-Free</span> Relocation Process', sub: 'Four steps from first call to final box, whether you’re relocating across DC or across the country.' };
---

<section class="how" aria-labelledby="how-heading">
  <div class="how-inner">
    <header class="how-head">
      <p class="eyebrow">How It Works</p>
      <h2 id="how-heading" set:html={copy.heading} />
      <p class="sub">{copy.sub}</p>
    </header>

    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <div class="badge">
            <svg viewBox="0 0 48 48" aria-hidden="true">
              {s.icon === 'phone' && <path d="M15 21a20 20 0 0 0 12 12l4-4a1.5 1.5 0 0 1 1.6-.4 15 15 0 0 0 4.9.8 1.5 1.5 0 0 1 1.5 1.5v6.3A1.5 1.5 0 0 1 37.5 39 27.5 27.5 0 0 1 9 10.5 1.5 1.5 0 0 1 10.5 9h6.3a1.5 1.5 0 0 1 1.5 1.5c0 1.7.3 3.4.8 4.9a1.5 1.5 0 0 1-.4 1.6z" />}
              {s.icon === 'plan' && <path d="M12 6h24v36H12zM18 4h12v6H18zM18 18h12M18 25h12M18 32h7M29 33l3 3 6-7" />}
              {s.icon === 'truck' && <><path d="M4 12h26v22H4zM30 19h8l6 8v7H30zM37 19v8h7" /><circle cx="12" cy="36" r="4" /><circle cx="36" cy="36" r="4" /></>}
              {s.icon === 'home' && <path d="M6 22 24 7l18 15M11 18v23h26V18M20 41V30h8v11" />}
              {s.icon === 'dropoff' && <path d="M8 16 24 8l16 8v18l-16 8-16-8zM8 16l16 8 16-8M24 24v18M17 31l4 4 8-8" />}
            </svg>
            <span class="num">{i + 1}</span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="ctas">
      <a class="btn btn-primary" href="#quote">Get a Free Quote</a>
      <a class="btn btn-outline" href={site.phoneHref}>Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .how {
    padding: var(--space-8) max(16px, 5%);
    background: var(--cream);
  }
  .how-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .how-head {
    max-width: 920px;
    margin: 0 auto var(--space-7);
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-dark);
  }
  h2 {
    font-size: clamp(2.125rem, 4vw, 3.25rem);
    line-height: 1.1;
    color: var(--black);
    text-wrap: balance;
  }
  h2 :global(.nw) {
    white-space: nowrap;
  }
  .sub {
    max-width: 680px;
    margin: var(--space-3) auto 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: #5a5a5a;
    text-wrap: balance;
  }

  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  /* timeline line running through the badge centers */
  .steps::before {
    content: '';
    position: absolute;
    top: 48px;
    left: 12.5%;
    right: 12.5%;
    border-top: 2px dashed var(--gold);
  }
  .step {
    position: relative;
    text-align: center;
  }
  .badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin: 0 auto var(--space-4);
    border-radius: 50%;
    background: var(--maroon);
    box-shadow: 0 0 0 8px var(--cream);
  }
  .badge svg {
    width: 44px;
    height: 44px;
    fill: none;
    stroke: var(--gold-light);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .num {
    position: absolute;
    top: -4px;
    right: -4px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--black);
    font-size: 1rem;
    font-weight: 800;
    border: 3px solid var(--cream);
  }
  h3 {
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--black);
  }
  .step p {
    max-width: 280px;
    margin: var(--space-2) auto 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #4a4a4a;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
  .btn {
    padding: 16px 32px;
    border-radius: var(--radius-sm);
    font-weight: var(--font-weight-button);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: filter 0.2s, background 0.2s, color 0.2s;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--maroon-light), var(--maroon-dark));
    color: var(--white);
  }
  .btn-primary:hover {
    filter: brightness(1.15);
  }
  .btn-outline {
    border: 2px solid var(--maroon);
    color: var(--maroon);
  }
  .btn-outline:hover {
    background: var(--maroon);
    color: var(--white);
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-6);
    }
    .steps::before {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .how {
      padding-block: var(--space-7);
    }
    .how-head {
      margin-bottom: var(--space-6);
    }
    .steps {
      grid-template-columns: 1fr;
    }
    .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
