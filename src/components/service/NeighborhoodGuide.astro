---
// Neighborhood-by-neighborhood guide for primary-market town pages (DC,
// Alexandria): how relocations differ block to block. Real local detail only.
interface Props {
  heading: string;
  intro: string;
  items: { name: string; text: string }[];
}

const { heading, intro, items } = Astro.props;
---

<section class="guide" aria-labelledby="guide-heading">
  <div class="guide-inner">
    <header class="head">
      <p class="eyebrow">Neighborhood Guide</p>
      <h2 id="guide-heading">{heading}</h2>
      <p class="sub">{intro}</p>
    </header>
    <dl class="grid">
      {items.map((it) => (
        <div class="item">
          <dt>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" /></svg>
            {it.name}
          </dt>
          <dd>{it.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .guide {
    padding: var(--space-8) max(16px, 5%);
    background: var(--cream);
  }
  .guide-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .head {
    max-width: 820px;
    margin: 0 auto var(--space-6);
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-dark);
  }
  h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.1;
    color: var(--black);
    text-wrap: balance;
  }
  .sub {
    margin: var(--space-3) 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: #5a5a5a;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--space-4);
    margin: 0;
  }
  .item {
    padding: var(--space-4);
    background: var(--white);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--maroon);
    border-radius: var(--radius-sm);
  }
  dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    color: var(--maroon);
  }
  dt svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    fill: var(--gold-dark);
  }
  dd {
    margin: var(--space-2) 0 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #444;
  }
  @media (max-width: 600px) {
    .guide {
      padding-block: var(--space-7);
    }
  }
</style>
