---
// Inner-page hero for service + pillar pages: visible breadcrumb trail
// (mirrors the BreadcrumbList JSON-LD), keyword H1, intro, dual CTA, and a
// compact trust bar reusing only the claims already on the home page.
import { site } from '../../data/site';
import type { Photo } from '../../data/photos';

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  kicker: string;
  h1: string;
  intro: string;
  crumbs: Crumb[];
  /** Optional background photo (washed in maroon so text stays readable). */
  image?: Photo;
}

const { kicker, h1, intro, crumbs, image } = Astro.props;
const trust = ['DOT & MC Certified', 'Licensed & Insured', '20+ Years Experience', 'Free, Upfront Quotes', 'Local & Lower-48 Relocations'];
---

<section class:list={['s-hero', { 'has-img': image }]}>
  {image && <img class="s-hero-bg" src={image.src} alt={image.alt} width="2000" height="1000" fetchpriority="high" decoding="async" />}
  <div class="s-hero-inner">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((c, i) => (
          <li>
            {i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>

    <p class="kicker">{kicker}</p>
    <h1>{h1}</h1>
    <p class="intro">{intro}</p>

    <div class="ctas">
      <a class="btn btn-gold" href="#quote">Get a Free Quote</a>
      <a class="btn btn-outline" href={site.phoneHref}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
        Call {site.phone}
      </a>
    </div>

    <ul class="trust">
      {trust.map((t) => (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 13 6 6L21 6" /></svg>
          {t}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .s-hero {
    padding: var(--space-6) max(16px, 5%) var(--space-7);
    background:
      radial-gradient(ellipse at 85% 10%, rgb(201 162 74 / 0.18), transparent 50%),
      radial-gradient(ellipse at 70% 30%, var(--maroon-light) 0%, var(--maroon) 40%, var(--maroon-dark) 75%, var(--black) 120%);
    color: var(--white);
  }
  .has-img {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .s-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* heavier maroon on the text side, lighter on the photo side */
  .has-img::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(52 12 14 / 0.94) 0%, rgb(74 17 20 / 0.86) 45%, rgb(74 17 20 / 0.55) 100%);
  }
  .s-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgb(255 255 255 / 0.75);
  }
  .crumbs li + li::before {
    content: '/';
    color: var(--gold);
  }
  .crumbs a {
    color: rgb(255 255 255 / 0.85);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--gold-light);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--white);
    font-weight: 600;
  }

  .kicker {
    margin: 0 0 var(--space-3);
    font-size: clamp(0.875rem, 1.2vw, 1.0625rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-light);
  }
  h1 {
    max-width: 950px;
    font-size: clamp(2.375rem, 4.6vw, 3.875rem);
    line-height: 1.08;
    text-wrap: balance;
  }
  .intro {
    max-width: 780px;
    margin: var(--space-4) 0 0;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.9);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    border-radius: var(--radius-sm);
    font-size: 1.0625rem;
    font-weight: var(--font-weight-button);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, filter 0.2s;
  }
  .btn svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .btn-gold {
    background: linear-gradient(135deg, var(--gold-light), var(--gold));
    color: var(--black);
  }
  .btn-gold:hover {
    filter: brightness(1.08);
  }
  .btn-outline {
    border: 2px solid var(--white);
    color: var(--white);
  }
  .btn-outline:hover {
    background: var(--white);
    color: var(--maroon);
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.18);
    list-style: none;
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }
  .trust svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--gold);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 600px) {
    .s-hero {
      padding-block: var(--space-5) var(--space-6);
    }
    .has-img::before {
      background: rgb(52 12 14 / 0.86);
    }
    .crumbs ol {
      margin-bottom: var(--space-4);
      font-size: 0.875rem;
    }
    .btn {
      width: 100%;
    }
    .trust {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      font-size: 0.9375rem;
    }
  }
</style>
