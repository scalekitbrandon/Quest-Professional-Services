---
// Card grid of services (used on pillar hubs). Each card links to the
// service page so the hub passes authority down to every child.
import ServiceIcon from './ServiceIcon.astro';

interface Card {
  name: string;
  href: string;
  blurb: string;
  icon: string;
}

interface Props {
  heading: string;
  intro: string;
  cards: Card[];
}

const { heading, intro, cards } = Astro.props;
---

<section class="cards" aria-labelledby="cards-heading">
  <div class="cards-inner">
    <header class="head">
      <p class="eyebrow">Our Services</p>
      <h2 id="cards-heading">{heading}</h2>
      <p class="sub">{intro}</p>
    </header>
    <ul class="grid" style={`--cols:${cards.length === 4 ? 4 : 3}`}>
      {cards.map((c) => (
        <li class="card">
          <span class="icon"><ServiceIcon name={c.icon} /></span>
          <h3><a href={c.href}>{c.name}</a></h3>
          <p>{c.blurb}</p>
          <a class="more" href={c.href} aria-label={`Learn more about ${c.name}`}>
            Learn More
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cards {
    padding: var(--space-8) max(16px, 5%);
    background: var(--cream);
  }
  .cards-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .head {
    max-width: 820px;
    margin: 0 auto var(--space-6);
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-dark);
  }
  h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.1;
    color: var(--black);
    text-wrap: balance;
  }
  .sub {
    margin: var(--space-3) 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: #5a5a5a;
    text-wrap: balance;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .card:hover {
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.1);
    transform: translateY(-3px);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: var(--space-3);
    border-radius: 50%;
    background: var(--maroon);
  }
  .icon :global(svg) {
    width: 40px;
    height: 40px;
    fill: none;
    stroke: var(--gold-light);
    stroke-width: 2.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  h3 {
    font-size: 1.625rem;
    line-height: 1.15;
  }
  h3 a {
    color: var(--black);
    text-decoration: none;
  }
  /* whole card clickable via the heading link */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:hover h3 a {
    color: var(--maroon);
  }
  .card p {
    margin: var(--space-2) 0 var(--space-4);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #444;
  }
  .more {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--maroon);
    text-decoration: none;
  }
  .more svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .cards {
      padding-block: var(--space-7);
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
